digraph arch {
  rankdir=TB; dpi=200; nodesep=0.4; ranksep=0.5;
  node [fontname="DejaVu Sans", fontsize=9.5, shape=box, style="rounded,filled", penwidth=1.3];
  edge [fontname="DejaVu Sans", fontsize=8.5, color="#444444"];
  subgraph cluster_ui { label="Presentación (UIKit)"; fontname="DejaVu Sans Bold"; fontsize=10; style=rounded; color="#2F6DB5";
    vcs [label="LoginVC · RegistroVC\nTaskListVC · TaskDetailVC", fillcolor="#EAF1FA", color="#2F6DB5"];
    cell [label="TaskCell\n(plantilla reutilizable)", fillcolor="#EAF1FA", color="#2F6DB5"];
  }
  subgraph cluster_core { label="TodoCore (sin UIKit ni Firebase)"; fontname="DejaVu Sans Bold"; fontsize=10; style=rounded; color="#1F6E4A";
    store [label="TaskStore\n(@MainActor, async)", fillcolor="#E8F1EC", color="#1F6E4A"];
    model [label="struct TodoTask\nCodable · Identifiable", fillcolor="#E8F1EC", color="#1F6E4A"];
    proto [label="«protocol» TaskRepository\nfetch · add · update · delete", fillcolor="#FFFFFF", color="#1F6E4A"];
  }
  subgraph cluster_data { label="Datos (target iOS)"; fontname="DejaVu Sans Bold"; fontsize=10; style=rounded; color="#C98A1B";
    auths [label="AuthService.shared\n(singleton de sesión)", fillcolor="#FFF4DC", color="#C98A1B"];
    repo [label="FirestoreTaskRepository\nTaskDocument ⇄ TodoTask", fillcolor="#FFF4DC", color="#C98A1B"];
    mem [label="InMemoryTaskRepository\n(pruebas)", fillcolor="#F4F6F8", color="#777777"];
  }
  fb [shape=cylinder, label="Firebase\nAuth + Firestore\n(caché sin conexión)", fillcolor="#FFFFFF", color="#C98A1B"];
  vcs -> cell [label="configura"];
  vcs -> store [label="eventos de UI"];
  store -> vcs [label="estado: cargando /\nlista / error", style=dashed];
  store -> model; store -> proto [label="depende de"];
  repo -> proto [style=dashed, arrowhead=empty, label="implementa"];
  mem -> proto [style=dashed, arrowhead=empty];
  vcs -> auths [label="login / logout"];
  auths -> fb; repo -> fb [label="async/await"];
  auths -> repo [label="uid", style=dotted, constraint=false];
}
